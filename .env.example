# Copiar a .env antes de arrancar la API.
# Prisma y el servidor leen este archivo desde la raíz del repositorio.

# PostgreSQL levantado con docker compose.
DATABASE_URL="postgresql://atiende:atiende@localhost:5432/atiendete?schema=public"

# Mosquitto levantado con docker compose.
MQTT_URL="mqtt://localhost:1883"

# La API escucha en todas las interfaces para que los celulares de la red local entren.
HOST=0.0.0.0
PORT=3000

# Opcional. Vacío: las notas se guardan tal cual (traductor de paso).
# Con clave: las notas cuyo idioma de origen es inglés se traducen al español
# con Google Cloud Translation API v2.
GOOGLE_TRANSLATE_API_KEY=
